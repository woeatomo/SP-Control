@* Popup detail spare part (dipakai di Master Data). Diisi oleh SP.showPart() di site.js. *@
<div class="modal fade" id="partModal" tabindex="-1" data-admin="@(User.IsInRole("Admin") ? "1" : "0")" data-prices="@(User.IsInRole("Admin") || User.IsInRole("Viewer") ? "1" : "0")">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title" id="pmTitle">Detail Spare Part</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="pmBody"></div>
            <div class="modal-footer py-2" id="pmFoot"></div>
        </div>
    </div>
</div>
