@* Popup permintaan part untuk PC ruang sparepart (diisi oleh requests.js). *@
<div class="modal fade" id="reqModal" tabindex="-1" aria-labelledby="reqTitle">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content req-modal">
            <div class="modal-header">
                <div>
                    <div class="req-kicker" id="reqKicker">Permintaan part</div>
                    <h5 class="modal-title" id="reqTitle">…</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <div class="modal-body" id="reqBody"></div>
            <div class="modal-footer" id="reqFoot"></div>
        </div>
    </div>
</div>
<div class="req-toast" id="reqToast" role="status" aria-live="polite"></div>
