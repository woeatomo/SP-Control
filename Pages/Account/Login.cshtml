@page
@model SparePartControl.Pages.Account.LoginModel
@inject SparePartControl.Services.AppSettingsService AppSettings
@{ ViewData["Title"] = "Login"; }
<div class="d-flex justify-content-center" style="margin-top:8vh">
    <form method="post" class="card" style="width:360px">
        <div class="card-body p-4">
            <h1 class="h5 mb-1">⚙ @AppSettings.Company.AppTitle</h1>
            @if (!string.IsNullOrWhiteSpace(AppSettings.Company.CompanyName)) { <div class="fw-semibold small">@AppSettings.Company.CompanyName</div> }
            <p class="text-muted small mb-3">Silakan login untuk melanjutkan.</p>
            @if (Model.Error != null) { <div class="alert alert-danger py-2 small">@Model.Error</div> }
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-2">
                <label class="form-label" asp-for="Username">Username</label>
                <input asp-for="Username" class="form-control" autocomplete="username" required autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required />
            </div>
            <button class="btn btn-primary w-100" type="submit">Login</button>
        </div>
    </form>
</div>
