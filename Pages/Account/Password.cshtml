@page
@model SparePartControl.Pages.Account.PasswordModel
@{ ViewData["Title"] = "Ganti Password"; }
<h1 class="page-title mb-3">Ganti Password</h1>
<form method="post" class="card" style="max-width:420px">
    <div class="card-body">
        @if (Model.Error != null) { <div class="alert alert-danger py-2 small">@Model.Error</div> }
        <div class="mb-2"><label class="form-label">Password lama</label><input type="password" name="current" class="form-control" autocomplete="current-password" required autofocus /></div>
        <div class="mb-2"><label class="form-label">Password baru (min. 8 karakter)</label><input type="password" name="newPassword" class="form-control" autocomplete="new-password" minlength="8" required /></div>
        <div class="mb-0"><label class="form-label">Ulangi password baru</label><input type="password" name="confirm" class="form-control" autocomplete="new-password" minlength="8" required /></div>
    </div>
    <div class="card-footer"><button class="btn btn-primary" type="submit">Simpan</button></div>
</form>
